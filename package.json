{
  "name": "canary-token-generator",
  "version": "1.0.0",
  "description": "Client-side canary token generator — web bugs, decoy PDFs, fake credentials and .env bait for breach and intrusion detection.",
  "type": "module",
  "license": "MIT",
  "author": "Armand van Wyk",
  "homepage": "https://armand-vw.github.io/Canary-Token-Generator/",
  "repository": {
    "type": "git",
    "url": "https://github.com/armand-vw/Canary-Token-Generator.git"
  },
  "keywords": [
    "canary-tokens",
    "honeytoken",
    "security",
    "threat-detection",
    "blue-team",
    "github-pages"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/styles.css --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build:css"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.17.0",
    "fflate": "^0.8.2",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.4.2",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
